{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gikoanyway-blog",
  "main": "./src/server.ts",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 9 * * *"],
  },
  "routes": [
    {
      "pattern": "gikoanyway.top",
      "custom_domain": true,
    },
  ],
  "vars": {
    "VITE_BASE_URL": "https://gikoanyway.top",
    "CMS_PUBLIC_SITE_URL": "https://gikoanyway.top",
    "CMS_BACKUP_RETENTION_DAYS": "30",
    "CMS_EMAIL_SENDING_ENABLED": "false",
    "CMS_EMAIL_FROM": "",
    "CMS_EMAIL_TO": "",
    "CMS_PASSWORD_RESET_TTL_MINUTES": "30",
    "VITE_TURNSTILE_SITE_KEY": "",
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "gikoanyway-blog-db",
      "database_id": "0564d5df-eb7e-472a-8133-396dc4496a26",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CMS_CACHE",
      "id": "f5b708c548a54f71affa548c669584d5",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CMS_STORAGE",
      "bucket_name": "gikoanyway-blog-assets",
    },
  ],
}
